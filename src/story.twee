:: Story JavaScript [script]
/* Harlowe owns story state. This layer only controls presentation and local media. */
window.FinalIP = (() => {
  const audio = new Audio(); audio.preload='none';
  let current=null, media=null, transition=null, words=[], generation=0, closeDrawer=null;
  const tokens=['They','still','talk','to','me.'];
  const q=(s)=>current?.querySelector(s);
  function stop(){generation++; audio.pause();audio.removeAttribute('src');audio.load();}
  function image(el,path){if(!el)return;el.src=path;el.onerror=()=>{el.onerror=null;el.src='assets/images/view-a.svg';el.alt='素材缺失：开发占位';};}
  function renderWords(){
    const bank=q('.word-bank'),sentence=q('.sentence');if(!bank)return;
    bank.replaceChildren();sentence.replaceChildren();
    tokens.forEach((t,i)=>{const b=document.createElement('button');b.textContent=t;b.disabled=words.includes(i);b.onclick=()=>{words.push(i);renderWords();sentence.lastElementChild?.querySelector('button')?.focus();};bank.append(b);});
    words.forEach((i,n)=>{const group=document.createElement('span');
      const b=document.createElement('button');b.textContent=tokens[i];b.title='移除此词';b.onclick=()=>{words.splice(n,1);renderWords();bank.children[i]?.focus();};group.append(b);
      [-1,1].forEach(d=>{const move=document.createElement('button');move.textContent=d<0?'←':'→';move.setAttribute('aria-label',d<0?'左移':'右移');move.disabled=n+d<0||n+d>=words.length;move.onclick=()=>{[words[n],words[n+d]]=[words[n+d],words[n]];renderWords();};group.append(move);});sentence.append(group);
    });
  }
  function mount(){
    const el=document.querySelector('tw-passage:last-of-type .story-shell');
    if(!el||el===current)return;current=el;closeDrawer=null;stop();clearTimeout(transition);words=[];
    const scene=q('#scene-id').textContent.trim();
    const entry=[...document.querySelectorAll('tw-storydata > tw-passagedata')].find(p=>p.getAttribute('name')===scene+'_Media');
    try{media=JSON.parse(entry.textContent);}catch(e){console.error('Invalid scene media: '+scene,e);media={camera:[],audio:'',subtitles:[]};}
    current.dataset.scene=scene;
    image(q('.camera-mini'),media.camera[0]);image(q('.closing-image'),media.closing);
    if(/^E[1-5]$/.test(scene)&&q('.closing-preview')){q('.closing-preview').hidden=false;image(q('.closing-preview'),media.closing);}
    const grid=q('.camera-grid');if(grid){grid.replaceChildren();media.camera.forEach((path,i)=>{
      const b=document.createElement('button');b.className='camera-tile';b.setAttribute('aria-pressed',String(i===0));b.setAttribute('aria-label','Camera '+(i+1));
      const img=document.createElement('img');image(img,path);b.append(img);const label=document.createElement('span');label.textContent='Camera '+(i+1);b.append(label);
      b.onclick=()=>{grid.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));};grid.append(b);
    });}
    const flags=q('#flags').textContent;
    if((scene==='T0'&&q('.prediction-copy'))||(scene==='T3'&&flags.includes('自身预测：true'))){const img=q('.prediction-image');img.hidden=false;image(img,media.prediction);}
    const day=q('.day-transition');day.textContent='DAY '+media.day+' · '+scene;current.classList.add('in-transition');
    transition=setTimeout(()=>current===el&&el.classList.remove('in-transition'),matchMedia('(prefers-reduced-motion: reduce)').matches?0:Math.max(0,Number(media.transitionMs)||0));
    const play=q('.play-audio');if(play){play.hidden=!media.audio;play.onclick=async()=>{
      if(!audio.paused)return;const g=generation;audio.src=media.audio;
      try{await audio.play();if(g!==generation)audio.pause();}catch(e){if(g===generation)play.textContent='音频暂不可用；可继续流程';}
    };}
    audio.ontimeupdate=()=>{const cue=(media.subtitles||[]).find(c=>audio.currentTime>=c.start&&audio.currentTime<c.end);if(q('.subtitle'))q('.subtitle').textContent=cue?cue.text:'';};
    renderWords();
    let drawer='',opener=null;
    const close=(focus=false)=>{if(!q('.drawer'))return;q('.drawer').hidden=true;q('.paper-grid').classList.remove('has-drawer');current.querySelectorAll('[data-drawer]').forEach(b=>b.setAttribute('aria-expanded','false'));drawer='';if(focus)opener?.focus();};
    current.querySelectorAll('[data-drawer]').forEach(b=>{b.setAttribute('aria-expanded','false');b.onclick=()=>{
      if(drawer===b.dataset.drawer){close();return;}drawer=b.dataset.drawer;opener=b;
      q('.drawer').hidden=false;q('.paper-grid').classList.add('has-drawer');q('.drawer h2').textContent=b.textContent;
      current.querySelectorAll('[data-record-kind]').forEach(x=>x.hidden=x.dataset.recordKind!==drawer);
      current.querySelectorAll('[data-drawer]').forEach(x=>x.setAttribute('aria-expanded',String(x===b)));
      q('.drawer-body').scrollTop=0;
    };});
    if(q('[data-close]'))q('[data-close]').onclick=()=>close(true);
    closeDrawer=()=>{if(drawer)close(true);};
    current.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{
      const cam=b.dataset.view==='camera';q('.left-rail').hidden=cam;q('.camera-view').hidden=!cam;q('.paper-grid').classList.toggle('camera-open',cam);
      q('.camera-reading').hidden=!cam;
    });
    if(q('[data-clear]'))q('[data-clear]').onclick=()=>{words=[];renderWords();};
    if(q('[data-intro-next]')){let line=0;q('[data-intro-next]').onclick=()=>{const all=current.querySelectorAll('.intro-lines p');if(line<all.length-1){all[line].hidden=true;all[++line].hidden=false;}if(line===all.length-1){q('.intro-exit').hidden=false;q('[data-intro-next]').hidden=true;}};}
    current.querySelectorAll('tw-link').forEach(x=>{x.setAttribute('role','link');});
  }
  new MutationObserver(mount).observe(document.documentElement,{childList:true,subtree:true});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeDrawer?.();});
  window.addEventListener('pagehide',stop);
  return {audio,stopAudio:stop};
})();

:: Story Stylesheet [stylesheet]
@font-face{font-family:RockSalt;src:url('assets/fonts/RockSalt-Regular.ttf')}@font-face{font-family:Caveat;src:url('assets/fonts/Caveat.ttf')}@font-face{font-family:Kalam;src:url('assets/fonts/Kalam-Regular.ttf')}@font-face{font-family:Reenie;src:url('assets/fonts/ReenieBeanie.ttf')}
*{box-sizing:border-box}body{margin:0;background:#e4dfd3;color:#30322d}tw-story{background:transparent;color:inherit;margin:0;padding:0;width:100%;font-family:Kalam,'Microsoft YaHei',sans-serif;font-size:20px;line-height:1.6}tw-passage{display:block}tw-sidebar{display:none}tw-link{color:#365a4b;text-decoration:underline;cursor:pointer}tw-link:hover{color:#923e30}tw-error{font-size:14px}.landing{max-width:750px;margin:10vh auto;padding:32px}.story-shell{max-width:1600px;margin:auto;padding:12px 24px}.story-shell header{display:flex;justify-content:space-between;font:14px/1.5 'Microsoft YaHei',sans-serif;padding:8px 0}.paper-grid{height:calc(100vh - 115px);min-height:390px;display:grid;grid-template-columns:30% 70%;grid-template-rows:minmax(0,1fr) auto;border:2px solid #626058;border-radius:4px 9px 3px 6px;background:repeating-linear-gradient(2deg,#f3efdf,#f3efdf 5px,#f1eddd 6px);overflow:hidden}.left-rail{display:flex;flex-direction:column;min-height:0;border-right:2px solid #716c60}.self-panel{flex:1;overflow:auto;padding:18px}.self-panel h2{font-family:Caveat;font-size:36px}.camera-panel{padding:12px;border-top:1px solid #716c60}.camera-mini{display:block;width:100%;max-height:26vh;object-fit:contain}.thinking-panel{padding:16px 24px;display:flex;flex-direction:column;min-height:0}.thinking-panel h2{font:26px RockSalt;margin:0 0 18px;text-shadow:.5px 1px 1px #757061}.thinking-scroll{overflow:auto;min-height:0;flex:1;overflow-wrap:anywhere}.scene-copy{font-size:22px;line-height:1.6}.camera-view{min-height:0;overflow:auto;padding:16px}.camera-open{grid-template-columns:60% 40%}.camera-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.camera-tile{padding:3px!important}.camera-tile img{width:100%;display:block}.camera-tile[aria-pressed=true]{outline:3px solid #566855}.closing-preview{width:100%;max-height:180px;object-fit:contain}.prediction-image{width:100%;max-height:180px;object-fit:contain}h2{font-family:Kalam;margin:0 0 10px;font-size:28px}button{font:inherit;color:inherit;background:none;border:0;border-bottom:1px solid #868173;cursor:pointer;padding:3px 9px}button:hover,button:focus-visible,tw-link:focus-visible{outline:2px solid #718d79;outline-offset:2px}button:disabled{opacity:.4;cursor:default}nav{grid-column:1/-1;display:flex;gap:15px;flex-wrap:wrap;border-top:2px solid #716c60;padding:6px 12px;font-family:Kalam}.fixture-actions{display:flex;gap:15px;flex-wrap:wrap;padding:14px 0}.fixture-actions small{flex-basis:100%;font:12px 'Microsoft YaHei',sans-serif;color:#746d60}.drawer{grid-column:1/-1;grid-row:2;display:flex;flex-direction:column;min-height:0;padding:8px 20px;border-top:1px solid #716c60}.drawer-head{display:flex;justify-content:space-between}.drawer-body{overflow:auto;min-height:0;line-height:1.6}.has-drawer{grid-template-rows:minmax(125px,1fr) minmax(0,38vh) auto}.has-drawer nav{grid-row:3}.record-list article{border-bottom:1px dashed #b1aa99;padding:8px 0}.record-list[data-record-kind=diary]{font-family:Reenie,'Microsoft YaHei',sans-serif;font-size:22px}.word-bank,.sentence{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.developer{font:13px/1.6 'Microsoft YaHei',sans-serif;padding-top:8px}.developer[open]{background:#fff5d9;padding:16px}.day-transition{display:none}.in-transition .day-transition{display:block;position:fixed;z-index:5;bottom:14px;left:50%;transform:translateX(-50%);padding:12px 30px;color:#fff;background:#111;font-size:17px}.in-transition .camera-panel,.in-transition .camera-view{background:#080909}.in-transition .camera-mini,.in-transition .camera-grid{visibility:hidden}.cinematic{background:#101311;color:#eee;min-height:100vh;display:flex;flex-direction:column;gap:16px}.cinematic .closing-image{width:100%;height:40vh;object-fit:contain;filter:brightness(.16) blur(4px)}.cinematic[data-scene=FinalE2] .closing-image{filter:none}.cinematic .developer[open]{color:#222}.intro-lines,.cinematic .scene-copy{max-width:900px;margin:auto}.blank-answer{height:100px;border:1px solid #72766c}.cinematic tw-link{color:#c8d9bd}[hidden]{display:none!important}
@media(max-width:850px){.story-shell{padding:6px 10px}.paper-grid{grid-template-columns:30% 70%}.camera-open{grid-template-columns:45% 55%}.thinking-panel{padding:12px}.scene-copy{font-size:18px}.thinking-panel h2{font-size:20px}.self-panel{padding:10px;font-size:16px}.camera-grid{grid-template-columns:1fr 1fr}.camera-tile span{font-size:13px}nav{gap:4px;font-size:18px}.has-drawer{grid-template-rows:minmax(125px,1fr) minmax(0,35vh) auto}}

:: SelfVision [scene technical] {"position":"1380,500","size":"100,100"}
{(set: $sceneActions to [[[查看预测后继续->T3]]])(set: $scene to "SelfVision")(display: "FinalFrame")}

:: SelfVision_Thinking [content-zh]
预测中的视觉观测中断。将其理解为死亡，尚不能确认。

:: SelfVision_Notes [notes]
仅实际执行自身预测后进入；确认演出后回到交易，已完成两项时自动进入 T4。

:: SelfVision_Media [media-config]
{"day": "待定", "transitionMs": 0, "camera": ["assets/images/skeleton/T3-camera-1.svg"], "prediction": "assets/images/skeleton/T3-prediction.svg", "closing": "assets/images/skeleton/T3-prediction.svg", "audio": "", "subtitles": [], "hotspots": []}

:: Skipped_Diary [content-zh] {"position":"2860,4450","size":"100,100"}
本次未执行轨迹预测；没有提供可用警告，轻微事故后停用。

:: TMinus3_Subtitle1 [content-zh] {"position":"1600,4900","size":"100,100"}
已通过预测验证；三名船员在发射厅交谈。

:: TMinus3_Subtitle2 [content-zh] {"position":"1780,4900","size":"100,100"}
预测需要外部问题或任务，看到的是未来输入片段。

:: TMinus3_Subtitle3 [content-zh] {"position":"1960,4900","size":"100,100"}
预测机制仍有未知；意识指标过阈值也不能证明意识。
