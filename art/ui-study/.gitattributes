# Keep the offline study reproducible across Windows and other checkouts.
* text=auto eol=lf
*.woff2 binary
*.ttf binary
fonts/*-OFL.txt -text whitespace=-blank-at-eol
fonts/*-LICENSE.txt -text whitespace=-blank-at-eol
# Preserve upstream license bytes and its original trailing space.
fonts/OFL.txt -text whitespace=-blank-at-eol
# Preserve the unchanged project fixture, including its original line endings.
assets/camera-placeholder.svg -text whitespace=cr-at-eol
assets/camera-placeholder-b.svg -text whitespace=cr-at-eol
